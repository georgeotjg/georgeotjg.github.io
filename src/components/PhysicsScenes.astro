---
// Animated physics backdrops, one per line of work. Each is either analytic
// physics or measured data, computed in the browser and labelled as an
// illustration — none of them is output from the research codes.
//   crystal  Debye–Scherrer rings from the measured XRD fit of Zn0.5Mg0.5Fe2O4
//   vortex   flux flow: vortices driven across a plain strip by a current
//   weyl     Berry curvature of a two-node Weyl lattice model
//   light    transmission deflectometry: a dot pattern seen through moving lenses
type SceneId = "crystal" | "vortex" | "weyl" | "light" | "diode";
interface Props {
  scenes: SceneId[];
  variant?: "hero" | "panel";
  auto?: boolean;
}
const { scenes, variant = "panel", auto = variant === "hero" } = Astro.props;
const labels: Record<SceneId, string> = {
  crystal: "Crystal",
  vortex: "Vortices",
  weyl: "Weyl nodes",
  light: "Light",
  diode: "Diode",
};
---

<div class={`scenes scenes--${variant}`} data-scenes={scenes.join(",")} data-variant={variant} data-auto={String(auto)}>
  <canvas aria-hidden="true"></canvas>
  <div class="scenes-hud">
    {
      scenes.length > 1 && (
        <div class="scenes-tabs" role="group" aria-label="Background scene">
          {scenes.map((s) => (
            <button type="button" data-scene={s} aria-pressed="false">
              {labels[s]}
            </button>
          ))}
        </div>
      )
    }
    <button type="button" data-act="pause" aria-pressed="false">Pause</button>
  </div>
</div>
{variant === "panel" && <p class="scene-caption" data-caption></p>}

<script>
  import spinel from "../data/spinel.json";

  type Pt = { x: number; y: number };
  type Scene = {
    caption: string;
    resize(w: number, h: number): void;
    reset(ctx: CanvasRenderingContext2D): void;
    frame(ctx: CanvasRenderingContext2D, dt: number): void;
    settle(ctx: CanvasRenderingContext2D): void;
    coarsen?(): void;
    pointer?(p: Pt | null): void;
    drag?(d: { dx: number; dy: number } | null): void;
    options?: { label: string; active(): boolean; apply(): void }[];
  };

  // Day and night palettes. Night: violet-black, violet, silver, wine.
  // Day: warm paper, chocolate ink, wine and bronze. The scenes read T at draw
  // time, so a theme change only needs a redraw.
  const PAL = {
    dark: {
      bg: [11, 9, 17], core: [11, 9, 17], inkRGB: "226,220,242", panelRGB: "14,11,20",
      ringLo: [140, 104, 240], ringHi: [226, 160, 190],
      poly: { Fe: [224, 172, 112], Zn: [196, 200, 222], Mg: [152, 122, 240] },
      alpha: { Fe: 0.5, Zn: 0.7, Mg: 0.7 }, oxy: [210, 84, 118],
      polyEdge: "rgba(226,220,242,0.22)", gloss: "rgba(255,255,255,0.26)",
      vortA: [96, 70, 190], vortB: [196, 84, 122],
      weyl: ["rgba(150,64,110,0.58)", "rgba(150,120,240,0.7)", "rgba(244,186,104,0.85)"],
      weylFade: "rgba(11,9,17,0.085)", weylGlow: "244,186,104", weylAxis: "rgba(184,178,200,0.6)",
      weylNode: "rgba(244,196,120,0.95)",
      pixel: [168, 158, 232],
      sheenA: "rgba(255,255,255,0.08)", sheenB: "rgba(169,139,255,0.07)",
      lensEdge: "rgba(226,220,242,0.7)", lensInner: "rgba(169,139,255,0.35)",
      axisLine: "rgba(196,170,255,0.95)", axisText: "rgba(196,180,255,0.95)",
      curRGB: "244,186,104", fieldRGB: "176,150,255", forceRGB: "246,120,160", slab: "rgba(226,220,242,0.4)",
    },
    light: {
      // Earthsong: warm dark brown panels on a sand page.
      bg: [41, 37, 32], core: [18, 20, 24], inkRGB: "229,199,169", panelRGB: "41,37,32",
      ringLo: [201, 92, 52], ringHi: [250, 214, 140],
      poly: { Fe: [236, 164, 60], Zn: [96, 168, 108], Mg: [206, 72, 56] },
      alpha: { Fe: 0.55, Zn: 0.7, Mg: 0.7 }, oxy: [229, 198, 170],
      polyEdge: "rgba(229,199,169,0.26)", gloss: "rgba(255,255,255,0.3)",
      vortA: [70, 142, 96], vortB: [240, 150, 64],
      weyl: ["rgba(240,104,90,0.78)", "rgba(132,200,92,0.8)", "rgba(245,174,46,0.95)"],
      weylFade: "rgba(41,37,32,0.085)", weylGlow: "245,174,46", weylAxis: "rgba(196,174,146,0.7)",
      weylNode: "rgba(246,236,214,0.95)",
      pixel: [229, 199, 169],
      sheenA: "rgba(255,255,255,0.08)", sheenB: "rgba(245,174,46,0.07)",
      lensEdge: "rgba(229,199,169,0.78)", lensInner: "rgba(245,174,46,0.35)",
      axisLine: "rgba(255,112,92,0.95)", axisText: "rgba(255,132,112,0.95)",
      curRGB: "245,174,46", fieldRGB: "120,214,236", forceRGB: "255,104,90", slab: "rgba(229,199,169,0.42)",
    },
  };
  let T = PAL.dark;
  const BG = [11, 9, 17];
  const POLY: Record<string, number[]> = { Fe: [0, 0, 0], Zn: [0, 0, 0], Mg: [0, 0, 0] };
  const ALPHA: Record<string, number> = { Fe: 0, Zn: 0, Mg: 0 };
  const OXY = [0, 0, 0];
  function applyTheme() {
    T = document.documentElement.dataset.theme === "light" ? PAL.light : PAL.dark;
    for (let i = 0; i < 3; i++) { BG[i] = T.bg[i]; OXY[i] = T.oxy[i]; }
    for (const k of ["Fe", "Zn", "Mg"]) {
      POLY[k] = T.poly[k as "Fe"]; ALPHA[k] = T.alpha[k as "Fe"];
    }
  }
  applyTheme();
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Polynomial atan2, |error| ~ 1e-5 rad: the phase sum is the per-pixel hot loop.
  function atan2(y: number, x: number) {
    const ax = Math.abs(x), ay = Math.abs(y);
    const a = Math.min(ax, ay) / (Math.max(ax, ay) + 1e-12);
    const s = a * a;
    let r = ((-0.0464964749 * s + 0.15931422) * s - 0.327622764) * s * a + a;
    if (ay > ax) r = 1.57079637 - r;
    if (x < 0) r = 3.14159274 - r;
    return y < 0 ? -r : r;
  }

  // Small live readout in the top-right corner of a scene.
  function readout(ctx: CanvasRenderingContext2D, w: number, hero: boolean, text: string) {
    if (hero && w < 640) return;
    ctx.save();
    ctx.font = `${hero ? 11 : 10}px "IBM Plex Mono", monospace`;
    const tw = ctx.measureText(text).width + 14;
    ctx.fillStyle = `rgba(${T.panelRGB},0.78)`;
    ctx.fillRect(w - tw - 10, 10, tw, 20);
    ctx.fillStyle = `rgba(${T.inkRGB},0.9)`;
    ctx.fillText(text, w - tw - 3, 24);
    ctx.restore();
  }

  const gauss = () => (Math.random() + Math.random() + Math.random() - 1.5) * 2;

  // Low-resolution pixel buffer, upscaled with smoothing onto the main canvas.
  function makeField(cell: number) {
    const off = document.createElement("canvas");
    const octx = off.getContext("2d")!;
    const f = {
      cell, gw: 0, gh: 0, w: 0, h: 0,
      img: null as ImageData | null,
      resize(w: number, h: number) {
        f.w = w; f.h = h;
        f.gw = Math.max(32, Math.round(w / f.cell));
        f.gh = Math.max(20, Math.round(h / f.cell));
        off.width = f.gw; off.height = f.gh;
        f.img = octx.createImageData(f.gw, f.gh);
      },
      blit(ctx: CanvasRenderingContext2D) {
        octx.putImageData(f.img!, 0, 0);
        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = "high";
        ctx.drawImage(off, 0, 0, f.w, f.h);
      },
    };
    return f;
  }

  // ---------------------------------------------------------------- crystal
  // Measured Kα1/Kα2 peaks of the three thesis samples (HighScore fits):
  // 2θ (deg), FWHM (deg), relative height (%). Lattice parameters are the
  // Rietveld values. The rotating cell is the Fd3̄m spinel from spinel.json
  // (A tetrahedral, B octahedral, O), generated by scripts/spinel_cell.py.
  const SAMPLES: { name: string; a: string; peaks: [number, number, number][] }[] = [
    {
      name: "ZnFe₂O₄", a: "8.384",
      peaks: [
        [29.931, 0.312, 29.14], [30.007, 0.312, 14.57], [35.286, 0.344, 100], [35.377, 0.344, 50],
        [42.938, 0.41, 16.76], [43.05, 0.41, 8.38], [53.31, 0.42, 9.84], [53.46, 0.42, 4.92],
        [56.817, 0.56, 22.64], [56.971, 0.56, 11.32], [62.424, 0.6, 27.58], [62.597, 0.6, 13.79],
      ],
    },
    {
      name: "Zn₀.₅Mg₀.₅Fe₂O₄", a: "8.397",
      peaks: [
        [18.261, 0.16, 2.14], [18.306, 0.16, 1.07], [30.085, 0.217, 29.09], [30.162, 0.217, 14.55],
        [35.4339, 0.254, 100], [35.5249, 0.254, 50], [43.022, 0.28, 24.26], [43.134, 0.28, 12.13],
        [53.439, 0.43, 8.47], [53.582, 0.43, 4.24], [56.951, 0.432, 26.54], [57.105, 0.432, 13.27],
        [62.512, 0.42, 39.04], [62.685, 0.42, 19.52], [70.97, 0.41, 2.56], [71.18, 0.41, 1.28],
      ],
    },
    {
      name: "MgFe₂O₄", a: "8.390",
      peaks: [
        [18.29, 0.11, 2.13], [18.336, 0.11, 1.07], [30.124, 0.195, 29.92], [30.201, 0.195, 14.96],
        [35.4777, 0.237, 100], [35.5688, 0.237, 50], [43.017, 0.373, 28.79], [43.129, 0.373, 14.39],
        [53.524, 0.36, 9.62], [53.667, 0.36, 4.81], [57.035, 0.375, 28.4], [57.189, 0.375, 14.2],
        [62.574, 0.442, 41.85], [62.747, 0.442, 20.92], [71.06, 0.47, 2.41], [71.26, 0.47, 1.21],
      ],
    },
  ];
  const HKL: [number, string][] = [
    [18.26, "111"], [30.08, "220"], [35.43, "311"], [43.02, "400"],
    [53.44, "422"], [56.95, "511"], [62.51, "440"], [70.97, "620"],
  ];
  // VESTA-style colours in the site palette (see PAL): Fe octahedra amber-brown,
  // Zn tetrahedra silver, Mg tetrahedra violet, oxygen wine.
  const CELL_LABEL = [
    "ZnFe₂O₄ · normal spinel, Zn on A sites",
    "Zn₀.₅Mg₀.₅Fe₂O₄ · ordered cell (illustrative)",
    "MgFe₂O₄ · inverse spinel, δ ≈ 0.9",
  ];

  function crystalScene(hero: boolean): Scene {
    const f = makeField(hero ? 3 : 2);
    let cx = 0, cy = 0, D = 0, L = 0, which = 1, prev = 1, held = 0, blend = 1;
    let rotY = 0, rotX = 0.38, dragging = false;
    let rates: Float32Array[] = [], peaks: number[] = [];
    let counts = new Float32Array(0), prevV = new Float32Array(0), exposure = 0;
    const hold = 7.5, pre = 220; // seconds per sample; counts/unit pre-exposure on switch

    function build() {
      const { gw, gh, cell } = f;
      cx = (hero ? 0.72 : 0.5) * f.w;
      cy = (hero ? 0.54 : 0.5) * f.h;
      D = ((hero ? 0.42 : 0.38) * Math.min(f.w, f.h * 1.6)) / Math.tan((35.43 * Math.PI) / 180);
      L = (hero ? 0.29 : 0.33) * Math.min(f.h, f.w * 0.6);
      rates = []; peaks = [];
      ensureRate(which);
      counts = new Float32Array(gw * gh);
      prevV = new Float32Array(gw * gh);
      expose(pre);
    }

    // Rings are radially symmetric: build a 1D profile I(r) once per sample and
    // look it up per pixel, and only when that sample is first shown.
    function ensureRate(idx: number) {
      if (rates[idx]) return;
      const { gw, gh, cell } = f;
      const sample = SAMPLES[idx];
      const dr = 0.5, rmax = Math.hypot(f.w, f.h) + 2;
      const prof = new Float32Array(Math.ceil(rmax / dr) + 2);
      for (let k = 0; k < prof.length; k++) {
        const r = k * dr;
        const tth = (Math.atan(r / D) * 180) / Math.PI;
        // Display floor on the width: a ring must span at least ~1.5 cells.
        const pxPerDeg = (D * (Math.PI / 180)) / Math.cos((tth * Math.PI) / 180) ** 2;
        const floor = (1.5 * cell) / pxPerDeg;
        let I = 0.6;
        for (const [p, w, a] of sample.peaks) {
          const fw = Math.sqrt(w * w + floor * floor);
          const u = (tth - p) / (fw / 2);
          I += a * (0.5 / (1 + u * u) + 0.5 * Math.exp(-0.693 * u * u));
        }
        prof[k] = r < 0.03 * f.h ? 0 : I; // beam stop
      }
      const rate = new Float32Array(gw * gh);
      let peak = 0;
      for (let j = 0; j < gh; j++)
        for (let i = 0; i < gw; i++) {
          const r = Math.hypot((i + 0.5) * cell - cx, (j + 0.5) * cell - cy);
          const I = prof[Math.round(r / dr)];
          rate[j * gw + i] = I;
          if (I > peak) peak = I;
        }
      rates[idx] = rate; peaks[idx] = peak;
    }

    // Cation on each site for each sample (A sites are cations 0–7, B sites 8–23).
    // ZnFe₂O₄: normal spinel. x = 0.5: the ordered cell of spinel.json.
    // MgFe₂O₄: inverse, δ ≈ 0.9 as in the reference card — 1 Mg + 7 Fe on A,
    // 7 Mg + 9 Fe on B.
    const MG_ON_B = new Set([0, 2, 5, 7, 9, 12, 14]);
    function kindOf(i: number, sample: number): string {
      const a = i < 8;
      if (sample === 0) return a ? "Zn" : "Fe";
      if (sample === 1) return spinel.cations[i].k;
      if (a) return i === 0 ? "Mg" : "Fe";
      return MG_ON_B.has(i - 8) ? "Mg" : "Fe";
    }

    function next() {
      const norm = 1 / (Math.max(exposure, 1e-6) * peaks[which]);
      for (let k = 0; k < counts.length; k++) prevV[k] = Math.min(1, Math.max(0, counts[k] * norm));
      prev = which;
      which = (which + 1) % SAMPLES.length;
      ensureRate(which);
      blend = 0;
      expose(pre);
    }

    // Start each pattern from a short exposure so the rings are visible at once.
    function expose(g: number) {
      const rate = rates[which];
      exposure = g;
      for (let k = 0; k < rate.length; k++) {
        const lam = Math.max(0, rate[k] * g);
        counts[k] = lam + Math.sqrt(lam) * gauss();
      }
    }

    function accumulate(dt: number) {
      const rate = rates[which], g = 24 * dt;
      for (let k = 0; k < rate.length; k++) {
        const lam = Math.max(0, rate[k] * g);
        counts[k] += lam + Math.sqrt(lam) * gauss();
      }
      exposure += g;
    }

    function drawRings(ctx: CanvasRenderingContext2D) {
      const d = f.img!.data;
      const norm = 1 / (Math.max(exposure, 1e-6) * peaks[which]);
      const b = blend * blend * (3 - 2 * blend); // smoothstep cross-fade between samples
      for (let k = 0; k < counts.length; k++) {
        let v = Math.min(1, Math.max(0, counts[k] * norm));
        if (b < 1) v = prevV[k] * (1 - b) + v * b;
        // Background → ringLo → ringHi as the counts rise.
        const s = Math.pow(v, 0.5);
        const hot = Math.max(0, s - 0.5) / 0.5;
        const o = k * 4;
        d[o] = BG[0] + (T.ringLo[0] - BG[0]) * s + (T.ringHi[0] - T.ringLo[0]) * hot;
        d[o + 1] = BG[1] + (T.ringLo[1] - BG[1]) * s + (T.ringHi[1] - T.ringLo[1]) * hot;
        d[o + 2] = BG[2] + (T.ringLo[2] - BG[2]) * s + (T.ringHi[2] - T.ringLo[2]) * hot;
        d[o + 3] = 255;
      }
      f.blit(ctx);
    }

    // Painter's algorithm over all polyhedron faces, Lambert-shaded by the
    // rotated face normal; oxygen spheres drawn in the same depth order.
    function drawCell(ctx: CanvasRenderingContext2D) {
      const th = rotY, tilt = rotX;
      const c1 = Math.cos(th), s1 = Math.sin(th), c2 = Math.cos(tilt), s2 = Math.sin(tilt);
      const rot = (fx: number, fy: number, fz: number) => {
        const x = (fx - 0.5) * L, y = (fy - 0.5) * L, z = (fz - 0.5) * L;
        const x1 = c1 * x + s1 * z, z1 = -s1 * x + c1 * z;
        return [x1, c2 * y - s2 * z1, s2 * y + c2 * z1];
      };
      const scr = (p: number[]) => {
        const k = (4 * L) / (4 * L - p[2]);
        return [cx + p[0] * k, cy - p[1] * k, k];
      };
      type Item = { z: number; draw: () => void };
      const items: Item[] = [];
      const light = [-0.35, 0.55, 0.76];
      const b = blend * blend * (3 - 2 * blend);
      spinel.cations.forEach((cat: { c: number[]; v: number[][]; f: number[][] }, ci: number) => {
        const k0 = kindOf(ci, prev), k1 = kindOf(ci, which);
        const base = POLY[k0].map((v, n) => v + (POLY[k1][n] - v) * b);
        const alpha = ALPHA[k0] + (ALPHA[k1] - ALPHA[k0]) * b;
        const V = cat.v.map((v: number[]) => rot(v[0], v[1], v[2]));
        const S = V.map(scr);
        const ctr = rot(cat.c[0], cat.c[1], cat.c[2]);
        for (const f of cat.f) {
          const [a, b, c] = f.map((i: number) => V[i]);
          let n = [
            (b[1] - a[1]) * (c[2] - a[2]) - (b[2] - a[2]) * (c[1] - a[1]),
            (b[2] - a[2]) * (c[0] - a[0]) - (b[0] - a[0]) * (c[2] - a[2]),
            (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0]),
          ];
          const m = (a[0] + b[0] + c[0]) / 3 - ctr[0], my = (a[1] + b[1] + c[1]) / 3 - ctr[1], mz = (a[2] + b[2] + c[2]) / 3 - ctr[2];
          if (n[0] * m + n[1] * my + n[2] * mz < 0) n = n.map((x) => -x); // outward
          const len = Math.hypot(n[0], n[1], n[2]) || 1;
          const lam = Math.max(0, (n[0] * light[0] + n[1] * light[1] + n[2] * light[2]) / len);
          const shade = 0.42 + 0.58 * lam;
          const zf = (a[2] + b[2] + c[2]) / 3;
          const [pa, pb, pc] = f.map((i: number) => S[i]);
          const col = base.map((v) => Math.round(v * shade));
          items.push({
            z: zf,
            draw: () => {
              ctx.fillStyle = `rgba(${col[0]},${col[1]},${col[2]},${alpha.toFixed(3)})`;
              ctx.strokeStyle = T.polyEdge;
              ctx.beginPath(); ctx.moveTo(pa[0], pa[1]); ctx.lineTo(pb[0], pb[1]); ctx.lineTo(pc[0], pc[1]);
              ctx.closePath(); ctx.fill(); ctx.stroke();
            },
          });
        }
      });
      for (const o of spinel.oxygens) {
        const p = rot(o[0], o[1], o[2]);
        const [x, y, k] = scr(p);
        const R = 0.03 * L * k;
        const shade = 0.6 + 0.4 * (0.5 + p[2] / L);
        items.push({
          z: p[2] + 0.02 * L,
          draw: () => {
            ctx.fillStyle = `rgb(${Math.round(OXY[0] * shade)},${Math.round(OXY[1] * shade)},${Math.round(OXY[2] * shade)})`;
            ctx.beginPath(); ctx.arc(x, y, R, 0, 7); ctx.fill();
            ctx.fillStyle = T.gloss;
            ctx.beginPath(); ctx.arc(x - 0.3 * R, y - 0.3 * R, 0.35 * R, 0, 7); ctx.fill();
          },
        });
      }
      items.sort((p, q) => p.z - q.z);
      ctx.save();
      ctx.lineWidth = 0.8;
      for (const it of items) it.draw();
      ctx.restore();
    }

    function drawLabels(ctx: CanvasRenderingContext2D) {
      if (hero && f.w < 640) return; // the hero text covers the scene on phones
      ctx.save();
      ctx.font = `${hero ? 11 : 10}px "IBM Plex Mono", monospace`;
      ctx.fillStyle = `rgba(${T.inkRGB},0.7)`;
      // Each hkl label sits on its ring, up and to the right, lowered toward
      // the horizontal until it fits inside the frame.
      for (const [p, hkl] of HKL) {
        const r = D * Math.tan((p * Math.PI) / 180);
        if (r < 0.75 * L) continue; // hidden behind the cell
        const up = Math.min(0.75, Math.asin(Math.min(1, (cy - 22) / r)));
        const x = cx + r * Math.cos(up) + 5, y = cy - r * Math.sin(up) - 5;
        if (x < f.w - 28) ctx.fillText(hkl, x, y);
      }
      const s = SAMPLES[which];
      const y0 = cy + 1.0 * L;
      const line = (text: string, y: number, size: number, alpha: number) => {
        ctx.font = `${size}px "IBM Plex Mono", monospace`;
        const wl = ctx.measureText(text).width + 14;
        ctx.fillStyle = `rgba(${T.panelRGB},0.8)`;
        ctx.fillRect(cx - wl / 2, y - size - 2, wl, size + 8);
        ctx.fillStyle = `rgba(${T.inkRGB},${alpha})`;
        ctx.fillText(text, cx, y);
      };
      ctx.textAlign = "center";
      line(CELL_LABEL[which], y0, hero ? 12 : 11, 0.95);
      line(`Rings: measured pattern, a = ${s.a} Å`, y0 + 20, hero ? 11 : 10, 0.8);
      ctx.textAlign = "left";
      ctx.font = `${hero ? 11 : 10}px "IBM Plex Mono", monospace`;
      const legend: [string, number[]][] = [["Fe", POLY.Fe], ["Zn", POLY.Zn], ["Mg", POLY.Mg], ["O", OXY]];
      let lx = cx - 118;
      for (const [text, rgb] of legend) {
        ctx.fillStyle = `rgb(${rgb[0]},${rgb[1]},${rgb[2]})`;
        ctx.fillRect(lx, y0 + 33, 9, 9);
        ctx.fillStyle = `rgba(${T.inkRGB},0.85)`;
        ctx.fillText(text, lx + 13, y0 + 42);
        lx += 62;
      }
      ctx.restore();
    }

    function draw(ctx: CanvasRenderingContext2D) { drawRings(ctx); drawCell(ctx); drawLabels(ctx); }

    return {
      caption:
        "Debye–Scherrer rings rebuilt from the measured X-ray patterns of the three samples (Cu Kα; positions, widths and intensities from the fits, Kα₁/Kα₂ doublets included), cycling ZnFe₂O₄ → Zn₀.₅Mg₀.₅Fe₂O₄ → MgFe₂O₄; counting noise falls as 1/√N. In front, the spinel cell with the cation distribution of each sample: Zn on the tetrahedral A sites in ZnFe₂O₄, an ordered Zn/Mg arrangement for x = 0.5 (illustrative, rebuilt here), and the largely inverse MgFe₂O₄ with Mg mostly on octahedral B sites. Drag the cell to rotate it.",
      resize(w, h) { f.resize(w, h); build(); },
      reset() { held = 0; blend = 1; prev = which; expose(pre); },
      frame(ctx, dt) {
        if (!dragging) rotY += 0.2 * dt;
        held += dt;
        if (held > hold) { held = 0; next(); }
        blend = Math.min(1, blend + dt / 1.4);
        accumulate(dt);
        draw(ctx);
      },
      settle(ctx) { expose(240); draw(ctx); },
      coarsen() { if (f.cell < 6) { f.cell++; f.resize(f.w, f.h); build(); } },
      drag(d) {
        if (!d) { dragging = false; return; }
        dragging = true;
        rotY += d.dx * 0.01;
        rotX = Math.max(-1.3, Math.min(1.3, rotX + d.dy * 0.01));
      },
    };
  }

  // ----------------------------------------------------------------- vortex
  function vortexScene(hero: boolean): Scene {
    const f = makeField(hero ? 6 : 5);
    const Ly = hero ? 30 : 20;
    let Lx = 40;
    let xs = new Float32Array(0), ys = new Float32Array(0);
    let vs: Pt[] = [];
    let pin: Pt | null = null, pinPx: Pt | null = null; // pointer as a pinning site
    let crossed = 0, clock = 0, rate = 0; // vortices leaving the far edge per unit time

    function occupied(x: number, y: number) {
      for (const v of vs) if ((v.x - x) ** 2 + (v.y - y) ** 2 < 2.6) return true;
      return false;
    }

    function step(dt: number) {
      if (Math.random() < 0.06 * Lx * dt) {
        const x = Math.random() * Lx;
        if (!occupied(x, 0.3)) vs.push({ x, y: 0.3 });
      }
      const n = vs.length, fx = new Float32Array(n), fy = new Float32Array(n);
      for (let a = 0; a < n; a++) {
        fy[a] += 2.6; // Lorentz force of the transport current
        if (pin) { // attractive pinning well, range ~2ξ
          const px = pin.x - vs[a].x, py = pin.y - vs[a].y, r2 = px * px + py * py;
          if (r2 < 25) { const g = 4.2 * Math.exp(-r2 / 3); fx[a] += g * px; fy[a] += g * py; }
        }
        for (let b = a + 1; b < n; b++) {
          const dx = vs[a].x - vs[b].x, dy = vs[a].y - vs[b].y;
          const r2 = dx * dx + dy * dy;
          if (r2 > 20) continue;
          const r = Math.sqrt(r2) + 1e-3;
          const g = (2.4 * Math.exp(-r / 1.4)) / r;
          fx[a] += g * dx; fy[a] += g * dy; fx[b] -= g * dx; fy[b] -= g * dy;
        }
      }
      const keep: Pt[] = [];
      for (let a = 0; a < n; a++) {
        const v = vs[a];
        v.x += (fx[a] + (Math.random() - 0.5) * 0.6) * dt;
        v.y += (fy[a] + (Math.random() - 0.5) * 0.6) * dt;
        if (v.y < Ly + 0.3 && v.x > -1 && v.x < Lx + 1) keep.push(v);
        else if (v.y >= Ly + 0.3) crossed++;
      }
      vs = keep;
      clock += dt;
      if (clock > 1) { rate = rate ? 0.7 * rate + 0.3 * (crossed / clock) : crossed / clock; crossed = 0; clock = 0; }
    }

    function draw(ctx: CanvasRenderingContext2D) {
      const { gw, gh } = f, d = f.img!.data;
      const n = vs.length, vx = new Float32Array(n), vy = new Float32Array(n);
      for (let a = 0; a < n; a++) { vx[a] = vs[a].x; vy[a] = vs[a].y; }
      for (let j = 0; j < gh; j++) {
        const y = ys[j];
        for (let i = 0; i < gw; i++) {
          const x = xs[i];
          let amp = 1, phase = 0.45 * x;
          for (let a = 0; a < n; a++) {
            const dx = x - vx[a], dy = y - vy[a], r2 = dx * dx + dy * dy;
            if (r2 < 25) { const w = 1 - r2 / 25; amp *= 1 - (0.9 / (r2 + 0.9)) * w * w; }
            phase += atan2(dy, dx);
          }
          const m = 0.5 + 0.5 * Math.cos(phase); // 0 → violet, 1 → silver
          const s = amp * amp, o = (j * gw + i) * 4;
          d[o] = T.core[0] + (T.vortA[0] + (T.vortB[0] - T.vortA[0]) * m - T.core[0]) * s;
          d[o + 1] = T.core[1] + (T.vortA[1] + (T.vortB[1] - T.vortA[1]) * m - T.core[1]) * s;
          d[o + 2] = T.core[2] + (T.vortA[2] + (T.vortB[2] - T.vortA[2]) * m - T.core[2]) * s;
          d[o + 3] = 255;
        }
      }
      f.blit(ctx);
      if (pinPx) {
        const r = (2 * f.h) / Ly;
        ctx.save();
        ctx.setLineDash([4, 4]);
        ctx.strokeStyle = `rgba(${T.inkRGB},0.55)`;
        ctx.beginPath(); ctx.arc(pinPx.x, pinPx.y, r, 0, 7); ctx.stroke();
        ctx.restore();
      }
      readout(ctx, f.w, hero, `vortex crossings ≈ ${rate.toFixed(1)} /s  ∝ V`);
    }

    function grid() {
      Lx = (Ly * f.w) / f.h;
      xs = new Float32Array(f.gw); ys = new Float32Array(f.gh);
      for (let i = 0; i < f.gw; i++) xs[i] = ((i + 0.5) / f.gw) * Lx;
      for (let j = 0; j < f.gh; j++) ys[j] = Ly * (1 - (j + 0.5) / f.gh);
    }

    return {
      caption:
        "Vortices driven across a superconducting strip by a transport current (flux flow). Each carries one flux quantum; colour is the phase of the order parameter, winding by 2π around each vortex core, and the moving vortices are what a voltmeter reads. The pointer acts as a pinning site that traps passing vortices. Superposed single-vortex profiles with simple overdamped motion — an illustration, not solver output.",
      resize(w, h) {
        f.resize(w, h); grid();
        vs = vs.filter((v) => v.x < Lx + 1);
        if (vs.length === 0) for (let s = 0; s < 420; s++) step(1 / 30);
      },
      reset() {},
      frame(ctx, dt) { step(dt); draw(ctx); },
      settle(ctx) { draw(ctx); },
      coarsen() { if (f.cell < 11) { f.cell++; f.resize(f.w, f.h); grid(); } },
      pointer(p) {
        pinPx = p;
        pin = p ? { x: (p.x / f.w) * Lx, y: Ly * (1 - p.y / f.h) } : null;
      },
    };
  }

  // ------------------------------------------------------------------- weyl
  // H(k) = sin kx σx + sin ky σy + [m(2 − cos kx − cos ky) + cos kz − cos k0] σz,
  // nodes at (0, 0, ±k0). Berry curvature Ω_c = ½ ε_cab d·(∂a d × ∂b d)/|d|³,
  // drawn in the ky = 0 plane (horizontal kz, vertical kx).
  function weylScene(hero: boolean): Scene {
    const m = 1, k0Rest = Math.PI / 2;
    let k0 = k0Rest, k0Target = k0Rest, ck0 = Math.cos(k0);
    let w = 0, h = 0, kxMax = 1, n = 0;
    let P = new Float32Array(0);

    function omega(kz: number, kx: number) {
      const sx = Math.sin(kx), cx = Math.cos(kx), sz = Math.sin(kz), cz = Math.cos(kz);
      const dz = m * (1 - cx) + cz - ck0;
      const d2 = sx * sx + dz * dz;
      const d3 = d2 * Math.sqrt(d2) + 1e-9;
      return [(0.5 * (dz * cx - m * sx * sx)) / d3, (-0.5 * sx * sz) / d3];
    }
    const X = (kz: number) => ((kz + Math.PI) / (2 * Math.PI)) * w;
    const Y = (kx: number) => h / 2 - (kx / kxMax) * (h / 2);

    function spawn(i: number) {
      P[i * 4] = (Math.random() * 2 - 1) * Math.PI;
      P[i * 4 + 1] = (Math.random() * 2 - 1) * kxMax;
      P[i * 4 + 2] = 0;
      P[i * 4 + 3] = 2 + Math.random() * 4;
    }

    let colors = T.weyl;

    function step(ctx: CanvasRenderingContext2D, dt: number) {
      k0 += (k0Target - k0) * Math.min(1, dt * 1.5);
      ck0 = Math.cos(k0);
      colors = T.weyl;
      ctx.fillStyle = T.weylFade;
      ctx.fillRect(0, 0, w, h);
      ctx.lineWidth = hero ? 1.1 : 1;
      const paths = colors.map(() => new Path2D());
      const v = 0.7;
      for (let i = 0; i < n; i++) {
        const o = i * 4;
        let kz = P[o], kx = P[o + 1];
        const [oz, ox] = omega(kz, kx);
        const mag = Math.hypot(oz, ox) + 1e-12;
        const nz = kz + (oz / mag) * v * dt, nx = kx + (ox / mag) * v * dt;
        P[o + 2] += dt;
        const lm = Math.log10(mag);
        const b = lm < -0.3 ? 0 : lm < 0.6 ? 1 : 2;
        let wz = nz;
        if (wz > Math.PI) wz -= 2 * Math.PI; else if (wz < -Math.PI) wz += 2 * Math.PI;
        if (wz === nz) { paths[b].moveTo(X(kz), Y(kx)); paths[b].lineTo(X(nz), Y(nx)); }
        P[o] = wz; P[o + 1] = nx;
        const nearSink = (wz - k0) ** 2 + nx * nx < 0.004;
        if (P[o + 2] > P[o + 3] || Math.abs(nx) > kxMax * 1.02 || nearSink) spawn(i);
      }
      paths.forEach((p, b) => { ctx.strokeStyle = colors[b]; ctx.stroke(p); });
      for (const [kz, label] of [[-k0, "χ = +1"], [k0, "χ = −1"]] as [number, string][]) {
        const x = X(kz), y = Y(0);
        // The trail fade never fully clears, so the glow is drawn faint and small.
        const R = 0.03 * h;
        const g = ctx.createRadialGradient(x, y, 0, x, y, R);
        g.addColorStop(0, `rgba(${T.weylGlow},0.16)`);
        g.addColorStop(1, `rgba(${T.weylGlow},0)`);
        ctx.fillStyle = g;
        ctx.beginPath(); ctx.arc(x, y, R, 0, 7); ctx.fill();
        ctx.fillStyle = T.weylNode;
        ctx.beginPath(); ctx.arc(x, y, 3, 0, 7); ctx.fill();
        ctx.font = `${hero ? 12 : 11}px "IBM Plex Mono", monospace`;
        ctx.fillStyle = `rgba(${T.panelRGB},0.88)`;
        ctx.fillRect(x + 8, y - 26, 62, 18);
        ctx.fillStyle = `rgba(${T.inkRGB},0.95)`;
        ctx.fillText(label, x + 12, y - 13);
      }
      ctx.font = `11px "IBM Plex Mono", monospace`;
      ctx.fillStyle = T.weylAxis;
      ctx.fillText("k_z →", 8, h - 10);
      ctx.fillText("k_x ↑", 8, 16);
      readout(ctx, w, hero, `node separation Δk_z = ${(2 * k0 / Math.PI).toFixed(2)} π/a`);
    }

    return {
      caption:
        "Berry curvature in momentum space for a two-node Weyl lattice model. Field lines leave one Weyl node — a monopole of charge +1 — and end on its partner (−1), also across the zone boundary. Moving the pointer pulls the two nodes apart or together, as the magnetization does in a magnetic Weyl semimetal. This analytic model is the first test bed of the nonlinear-optics project.",
      resize(nw, nh) {
        w = nw; h = nh;
        kxMax = (Math.PI * h) / w;
        n = Math.round(Math.min(1600, Math.max(350, (w * h) / 700)));
        P = new Float32Array(n * 4);
        for (let i = 0; i < n; i++) { spawn(i); P[i * 4 + 2] = Math.random() * P[i * 4 + 3]; }
      },
      reset(ctx) { ctx.fillStyle = `rgb(${BG[0]},${BG[1]},${BG[2]})`; ctx.fillRect(0, 0, w, h); },
      frame(ctx, dt) { step(ctx, dt); },
      settle(ctx) { this.reset(ctx); for (let s = 0; s < 90; s++) step(ctx, 1 / 30); },
      pointer(p) {
        k0Target = p ? Math.max(0.35, Math.min(2.8, Math.abs((p.x / w) * 2 * Math.PI - Math.PI))) : k0Rest;
      },
    };
  }

  // ------------------------------------------------------------------ light
  // The lensmeter set-up: a grid of screen pixels seen through a spectacle
  // lens. A thin lens with power matrix K maps the pattern point seen at p to
  // c + (I − K)(p − c), with K = S·I + C·m mᵀ: a sphere S plus a cylinder C
  // acting along m, perpendicular to the cylinder axis. Surface brightness is
  // conserved, so only positions change; K differs by ±1.2 % between colour
  // channels (dispersion), which gives faint colour fringes at the pixels.
  function lightScene(hero: boolean): Scene {
    const f = makeField(2);
    let w = 0, h = 0, t = 0, pitch = 14, R = 80;
    let target: Pt | null = null;
    const lens = { x: 0, y: 0, ang: 0, S: 0.42, C: 0.3, axis: 0.6 };
    let pattern = hero ? 0 : 1, vectors = false; // 0 pixels, 1 phase-shifting fringes
    const LDIST = 0.28; // lens–screen distance (m): power in dioptres = K / L
    const A = 1.2, B = 0.9; // lens semi-axes in units of R

    function place(dt: number) {
      t += dt;
      const ax = hero ? 0.7 : 0.5;
      const want = target ?? {
        x: w * (ax + 0.1 * Math.sin(t * 0.17)),
        y: h * (0.5 + 0.14 * Math.sin(t * 0.23 + 1)),
      };
      const e = target ? Math.min(1, dt * 6) : 1;
      lens.x += (want.x - lens.x) * e; lens.y += (want.y - lens.y) * e;
      lens.ang = 0.12 * Math.sin(t * 0.13);
      lens.axis = 0.6 + 1.1 * Math.sin(t * 0.1);
      lens.S = 0.42 + 0.05 * Math.sin(t * 0.09);
      lens.C = 0.3 + 0.05 * Math.sin(t * 0.07 + 1);
    }

    function draw(ctx: CanvasRenderingContext2D) {
      const { gw, gh, cell } = f, d = f.img!.data;
      const inv = 1 / pitch, ca = Math.cos(lens.ang), sa = Math.sin(lens.ang);
      const ma = lens.axis + Math.PI / 2;
      const mx = Math.cos(ma), my = Math.sin(ma);
      const K = [lens.S + lens.C * mx * mx, lens.C * mx * my, lens.S + lens.C * my * my];
      for (let j = 0; j < gh; j++) {
        const y = (j + 0.5) * cell;
        for (let i = 0; i < gw; i++) {
          const x = (i + 0.5) * cell;
          const dx = x - lens.x, dy = y - lens.y;
          const u = (dx * ca + dy * sa) / (A * R), v = (-dx * sa + dy * ca) / (B * R);
          const q = u * u + v * v;
          const inside = q < 1;
          const tq = inside ? Math.min(1, (1 - q) / 0.4) : 0, taper = tq * tq * (3 - 2 * tq);
          const o = (j * gw + i) * 4;
          for (let c = 0; c < 3; c++) {
            let sx = x, sy = y;
            if (inside) {
              const k = (1 + (c - 1) * 0.012) * taper;
              sx -= k * (K[0] * dx + K[1] * dy);
              sy -= k * (K[1] * dx + K[2] * dy);
            }
            let val: number;
            if (pattern === 0) {
              // Square "pixels" with soft edges, as on an LCD seen up close.
              let pu = sx * inv, pv = sy * inv;
              pu -= Math.floor(pu) + 0.5; pv -= Math.floor(pv) + 0.5;
              const m = Math.max(Math.abs(pu), Math.abs(pv));
              val = Math.max(0, Math.min(1, (0.3 - m) / 0.08));
            } else {
              // Phase-shifting fringes: the phase advances with time, as in the
              // measurement; the lens bends them by its local slope.
              const g = 0.5 + 0.5 * Math.cos(6.2832 * (sx * 0.955 + sy * 0.296) / (2.6 * pitch) - t * 2.4);
              val = g * g;
            }
            d[o + c] = BG[c] + val * (T.pixel[c] - BG[c]) * (inside ? 0.85 : 0.6);
          }
          d[o + 3] = 255;
        }
      }
      f.blit(ctx);
      if (vectors) drawShifts(ctx, K, ca, sa);
      drawLens(ctx);
    }

    // What the camera actually measures: the shift of each pattern feature,
    // K·(p − c), drawn as arrows over the lens.
    function drawShifts(ctx: CanvasRenderingContext2D, K: number[], ca: number, sa: number) {
      ctx.save();
      ctx.strokeStyle = T.axisLine; ctx.fillStyle = T.axisLine; ctx.lineWidth = 1.3;
      const step = 2.6 * pitch;
      for (let gy = -A * R; gy <= A * R; gy += step)
        for (let gx = -A * R; gx <= A * R; gx += step) {
          const ex = gx, ey = gy;
          const u = (ex * ca + ey * sa) / (A * R), v = (-ex * sa + ey * ca) / (B * R);
          if (u * u + v * v > 0.85) continue;
          const dx = K[0] * ex + K[1] * ey, dy = K[1] * ex + K[2] * ey;
          const x0 = lens.x + ex, y0 = lens.y + ey, x1 = x0 + dx, y1 = y0 + dy;
          const L = Math.hypot(dx, dy);
          if (L < 1) continue;
          const ux = dx / L, uy = dy / L;
          ctx.beginPath(); ctx.moveTo(x0, y0); ctx.lineTo(x1, y1); ctx.stroke();
          ctx.beginPath(); ctx.moveTo(x1, y1);
          ctx.lineTo(x1 - 5 * ux + 3 * uy, y1 - 5 * uy - 3 * ux);
          ctx.lineTo(x1 - 5 * ux - 3 * uy, y1 - 5 * uy + 3 * ux);
          ctx.closePath(); ctx.fill();
        }
      ctx.restore();
    }

    function drawLens(ctx: CanvasRenderingContext2D) {
      const { x, y, ang } = lens;
      ctx.save();
      // Rimless lens: a bright bevel and a faint sheen.
      const g = ctx.createLinearGradient(x - A * R, y - B * R, x + A * R, y + B * R);
      g.addColorStop(0, T.sheenA);
      g.addColorStop(0.5, "rgba(255,255,255,0)");
      g.addColorStop(1, T.sheenB);
      ctx.fillStyle = g;
      ctx.beginPath(); ctx.ellipse(x, y, A * R, B * R, ang, 0, 7); ctx.fill();
      ctx.strokeStyle = T.lensEdge;
      ctx.lineWidth = 1.6;
      ctx.stroke();
      ctx.strokeStyle = T.lensInner;
      ctx.lineWidth = 4;
      ctx.beginPath(); ctx.ellipse(x, y, A * R - 3, B * R - 3, ang, 0, 7); ctx.stroke();
      // Lensmeter reticle at the optical centre.
      ctx.strokeStyle = T.lensEdge;
      ctx.lineWidth = 1;
      const rr = 0.22 * R;
      ctx.beginPath(); ctx.arc(x, y, rr, 0, 7); ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(x - 0.45 * R, y); ctx.lineTo(x - rr - 4, y); ctx.moveTo(x + rr + 4, y); ctx.lineTo(x + 0.45 * R, y);
      ctx.moveTo(x, y - 0.45 * R); ctx.lineTo(x, y - rr - 4); ctx.moveTo(x, y + rr + 4); ctx.lineTo(x, y + 0.45 * R);
      ctx.stroke();
      // Cylinder axis.
      const ax = lens.axis, len = 0.85 * B * R;
      ctx.setLineDash([6, 5]);
      ctx.strokeStyle = T.axisLine;
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.moveTo(x - len * Math.cos(ax), y - len * Math.sin(ax));
      ctx.lineTo(x + len * Math.cos(ax), y + len * Math.sin(ax));
      ctx.stroke();
      ctx.setLineDash([]);
      if (!(hero && w < 640)) {
        ctx.font = `${hero ? 11 : 10}px "IBM Plex Mono", monospace`;
        ctx.textAlign = "center";
        ctx.fillStyle = T.axisText;
        ctx.fillText("axis", x + (len + 16) * Math.cos(ax), y + (len + 16) * Math.sin(ax) + 4);
        const text = "sphere + cylinder";
        const wl = ctx.measureText(text).width + 12, ly = y + B * R + 22;
        ctx.fillStyle = `rgba(${T.panelRGB},0.82)`;
        ctx.fillRect(x - wl / 2, ly - 12, wl, 18);
        ctx.fillStyle = `rgba(${T.inkRGB},0.9)`;
        ctx.fillText(text, x, ly + 1);
      }
      ctx.restore();
      const deg = ((((ax * 180) / Math.PI) % 180) + 180) % 180;
      readout(ctx, w, hero, `sph ${(lens.S / LDIST).toFixed(2)} D · cyl ${(lens.C / LDIST).toFixed(2)} D · axis ${deg.toFixed(0)}°`);
    }

    return {
      caption:
        "The lensmeter set-up: a pattern on a screen seen through a spectacle lens with sphere and cylinder, its axis turning slowly. The lens displaces the pattern according to its power — uniformly for the sphere, along one direction for the cylinder. Phase-shifting fringes, as used in deflectometry, make the displacement measurable at every point; the arrows show it, and the readout is the prescription it implies at a lens–screen distance of 28 cm. Moving the pointer over the panel moves the lens.",
      resize(nw, nh) {
        w = nw; h = nh; f.resize(w, h);
        pitch = Math.max(10, Math.min(18, h / 34));
        R = (hero ? 0.2 : 0.24) * Math.min(h * 1.3, w * 0.45);
        if (lens.x === 0) { lens.x = w * (hero ? 0.7 : 0.5); lens.y = h * 0.5; }
        place(0);
      },
      reset() {},
      frame(ctx, dt) { place(dt); draw(ctx); },
      settle(ctx) { place(0); draw(ctx); },
      coarsen() { if (f.cell < 4) { f.cell++; f.resize(w, h); } },
      pointer(p) { target = p; },
      options: [
        { label: "Pixels", active: () => pattern === 0, apply: () => { pattern = 0; } },
        { label: "Fringes", active: () => pattern === 1, apply: () => { pattern = 1; } },
        { label: "Shift vectors", active: () => vectors, apply: () => { vectors = !vectors; } },
      ],
    };
  }

  // ------------------------------------------------------------------ diode
  // Cartoon of the mechanism of the geometric diode (not solver output): the
  // same notched slab in a field B out of the page, driven by +J and by −J.
  // Vortices nucleate at the tip of the notch and cross the sample; they are
  // lines through the thickness. For one current a vortex, for the other an
  // antivortex (opposite charge and opposite current give the same Lorentz
  // force). The rectification is the difference in how long the next one waits
  // at the tip, where the current crowds. Wait times are illustrative; only
  // their asymmetry is the point. Oblique projection, front face = the face
  // with the notch.
  function diodeScene(hero: boolean): Scene {
    const f = makeField(2);
    const Lx = 24, Ly = 15, Lz = 6, nx0 = 10.5, nh = 4, ntop = 1.2, nw = 5; // ξ
    const tipX = nx0 + 0.6, tipY = nh + 0.35, SPEED = 5;
    const ZX = 0.42, ZY = 0.3; // screen offset per ξ of depth (× sc)
    const REGIMES = [
      { label: "Weak asymmetry", wp: 2.0, wm: 2.4, serial: true },
      { label: "Strong asymmetry", wp: 0.9, wm: 4.6, serial: true },
      { label: "Higher field", wp: 0.55, wm: 1.5, serial: false },
    ];
    let regime = 1;
    type V = { x: number; y: number };
    type Strip = { s: number; t: number; wait: number; vs: V[]; n: number; stamps: number[] };
    const mk = (s: number): Strip => ({ s, t: Math.random(), wait: 1.5, vs: [], n: 0, stamps: [] });
    let strips = [mk(1), mk(-1)];
    let w = 0, h = 0, sc = 10, ox = [0, 0], oy = 0, clock = 0, tt = 0;

    const inNotch = (X: number, Y: number) =>
      X >= nx0 && X <= nx0 + nw && Y <= nh && (X <= nx0 + ntop || Y < (nh * (nx0 + nw - X)) / (nw - ntop));
    const waitFor = (st: Strip) => {
      const rg = REGIMES[regime];
      return (st.s > 0 ? rg.wp : rg.wm) * (0.88 + 0.24 * Math.random());
    };
    function rateOf(st: Strip) {
      const a = st.stamps;
      if (a.length < 3) return 0;
      const k = Math.min(5, a.length - 1);
      return k / (a[a.length - 1] - a[a.length - 1 - k]);
    }
    function step(dt: number) {
      clock += dt; tt += dt;
      const rg = REGIMES[regime];
      for (const st of strips) {
        if (!rg.serial || st.vs.length === 0) st.t += dt;
        if (st.t >= st.wait && (!st.vs.length || st.vs[st.vs.length - 1].y > tipY + 2.4)) {
          st.vs.push({ x: tipX + (Math.random() - 0.5) * 0.4, y: tipY });
          st.t = 0; st.wait = waitFor(st);
        }
        for (const v of st.vs) {
          v.y += SPEED * dt;
          v.x += (Math.random() - 0.5) * 1.0 * dt + 0.3 * dt;
        }
        // Vortices repel: neighbours in a train spread sideways a little.
        for (let a = 0; a + 1 < st.vs.length; a++) {
          const dy = st.vs[a + 1].y - st.vs[a].y;
          if (dy < 2.6) { const g = (2.6 - dy) * 0.5 * dt; st.vs[a].x += g; st.vs[a + 1].x -= g; }
        }
        const keep: V[] = [];
        for (const v of st.vs) {
          if (v.y > Ly + 0.4) { st.n++; st.stamps.push(clock); if (st.stamps.length > 14) st.stamps.shift(); }
          else keep.push(v);
        }
        st.vs = keep;
      }
    }
    function resetStrips() {
      strips = [mk(1), mk(-1)];
      for (const st of strips) st.wait = waitFor(st);
      for (let k = 0; k < 1500; k++) step(1 / 30);
    }

    // Screen position of a sample point in strip k (Z = 0 front face, Lz back).
    const P = (k: number, X: number, Y: number, Z = 0) => [ox[k] + X * sc + Z * ZX * sc, oy - Y * sc - Z * ZY * sc];
    const txt = (ctx: CanvasRenderingContext2D, text: string, x: number, y: number, a: number) => {
      ctx.lineWidth = 3; ctx.lineJoin = "round";
      ctx.strokeStyle = `rgba(${T.panelRGB},0.85)`; ctx.strokeText(text, x, y);
      ctx.fillStyle = `rgba(${T.inkRGB},${a})`; ctx.fillText(text, x, y);
    };

    function draw(ctx: CanvasRenderingContext2D) {
      const { gw, gh, cell } = f, d = f.img!.data;
      // Front-face map with alpha: transparent outside the sample and in the notch.
      for (let j = 0; j < gh; j++) {
        const py = (j + 0.5) * cell, Y = (oy - py) / sc;
        for (let i = 0; i < gw; i++) {
          const px = (i + 0.5) * cell, k = px < w / 2 ? 0 : 1, X = (px - ox[k]) / sc, o = (j * gw + i) * 4;
          if (!(X >= 0 && X <= Lx && Y >= 0 && Y <= Ly && !inNotch(X, Y))) { d[o + 3] = 0; continue; }
          const st = strips[k];
          let amp = 1, phase = 0.45 * st.s * X;
          amp *= 1 - 0.3 * Math.exp(-Math.min(X, Lx - X, Y, Ly - Y) / 1.3);
          const stress = (REGIMES[regime].serial && st.vs.length) ? 0.25 : Math.min(1, st.t / Math.max(st.wait, 0.1));
          const tdx = X - tipX, tdy = Y - tipY;
          amp *= 1 - (0.15 + 0.55 * stress) * Math.exp(-(tdx * tdx + tdy * tdy) / 3.2);
          for (const v of st.vs) {
            const dx = X - v.x, dy = Y - v.y, r2 = dx * dx + dy * dy;
            if (r2 < 25) { const q = 1 - r2 / 25; amp *= 1 - (0.92 / (r2 + 0.9)) * q * q; }
            phase += st.s * atan2(dy, dx);
          }
          const m = 0.5 + 0.5 * Math.cos(phase), a2 = amp * amp;
          d[o] = T.core[0] + (T.vortA[0] + (T.vortB[0] - T.vortA[0]) * m - T.core[0]) * a2;
          d[o + 1] = T.core[1] + (T.vortA[1] + (T.vortB[1] - T.vortA[1]) * m - T.core[1]) * a2;
          d[o + 2] = T.core[2] + (T.vortA[2] + (T.vortB[2] - T.vortA[2]) * m - T.core[2]) * a2;
          d[o + 3] = 255;
        }
      }
      ctx.fillStyle = `rgb(${BG[0]},${BG[1]},${BG[2]})`;
      ctx.fillRect(0, 0, w, h);
      const poly = (k: number, pts: number[][], fill: string | null) => {
        ctx.beginPath();
        pts.forEach(([X, Y, Z], idx) => { const [a, b] = P(k, X, Y, Z); idx ? ctx.lineTo(a, b) : ctx.moveTo(a, b); });
        ctx.closePath();
        if (fill) { ctx.fillStyle = fill; ctx.fill(); }
        ctx.stroke();
      };
      ctx.save();
      // Thickness: top face, right face and the abrupt wall of the notch (translucent slab).
      ctx.lineWidth = 1; ctx.strokeStyle = T.slab;
      for (let k = 0; k < 2; k++) {
        poly(k, [[0, Ly, 0], [Lx, Ly, 0], [Lx, Ly, Lz], [0, Ly, Lz]], `rgba(${T.inkRGB},0.10)`);
        poly(k, [[Lx, 0, 0], [Lx, Ly, 0], [Lx, Ly, Lz], [Lx, 0, Lz]], `rgba(${T.inkRGB},0.16)`);
        poly(k, [[nx0, 0, 0], [nx0, nh, 0], [nx0, nh, Lz], [nx0, 0, Lz]], `rgba(${T.inkRGB},0.14)`);
        // The notch runs through the whole thickness: dashed back outline.
        ctx.setLineDash([3, 3]);
        poly(k, [[nx0, 0, Lz], [nx0, nh, Lz], [nx0 + ntop, nh, Lz], [nx0 + nw, 0, Lz]], null);
        ctx.setLineDash([]);
      }
      ctx.restore();
      f.blit(ctx);

      ctx.save();
      ctx.font = `12px "IBM Plex Mono", monospace`;
      ctx.textAlign = "center";
      strips.forEach((st, k) => {
        // Front outline with the notch.
        ctx.strokeStyle = T.slab; ctx.lineWidth = 1.6;
        const [ax, ay] = P(k, 0, 0);
        ctx.beginPath(); ctx.moveTo(ax, ay);
        for (const [X, Y] of [[nx0, 0], [nx0, nh], [nx0 + ntop, nh], [nx0 + nw, 0], [Lx, 0], [Lx, Ly], [0, Ly]]) { const [a, b] = P(k, X, Y); ctx.lineTo(a, b); }
        ctx.closePath(); ctx.stroke();
        // Current streamlines: they bend over the notch and crowd at its tip.
        ctx.lineWidth = 1.4; ctx.setLineDash([7, 8]);
        ctx.lineDashOffset = -st.s * tt * 22;
        ctx.strokeStyle = `rgba(${T.curRGB},0.62)`;
        for (const y0 of [1.5, 4.5, 7.5, 10.5, 13.5]) {
          const A = y0 < nh + 1.2 ? 0.9 * (nh + 1.2 - y0) : 0;
          ctx.beginPath();
          for (let X = 0; X <= Lx + 0.01; X += 0.5) {
            const u = (X - (nx0 + 1.8)) / 3.4;
            const Y = y0 + A * Math.exp(-u * u);
            const [a, b] = P(k, X, Y); X === 0 ? ctx.moveTo(a, b) : ctx.lineTo(a, b);
          }
          ctx.stroke();
        }
        ctx.setLineDash([]);
        // Vortex lines through the thickness.
        ctx.lineWidth = 2.2;
        ctx.strokeStyle = `rgba(${T.inkRGB},0.9)`;
        for (const v of st.vs) {
          const [a, b] = P(k, v.x, v.y, 0), [c, e] = P(k, v.x, v.y, Lz);
          ctx.beginPath(); ctx.moveTo(a, b); ctx.lineTo(c, e); ctx.stroke();
        }
        // Lorentz force F = J × B on each vortex (pointing across the sample).
        ctx.strokeStyle = `rgba(${T.forceRGB},0.95)`; ctx.fillStyle = `rgba(${T.forceRGB},0.95)`; ctx.lineWidth = 2.2;
        for (const v of st.vs) {
          const [a, b] = P(k, v.x, v.y, 0), b2 = b - 2.6 * sc;
          ctx.beginPath(); ctx.moveTo(a, b - 6); ctx.lineTo(a, b2); ctx.stroke();
          ctx.beginPath(); ctx.moveTo(a, b2 - 3); ctx.lineTo(a - 4.5, b2 + 5); ctx.lineTo(a + 4.5, b2 + 5); ctx.closePath(); ctx.fill();
        }
        // Field B: an arrow out of the front face, towards the viewer.
        {
          const [bx, by] = P(k, 3.4, Ly - 2.6, 0), [ex, ey] = P(k, 3.4, Ly - 2.6, -4.6);
          const ang = Math.atan2(ey - by, ex - bx);
          // Outline first, so the arrow reads over any part of the map.
          ctx.strokeStyle = `rgba(${T.panelRGB},0.9)`; ctx.lineWidth = 6;
          ctx.beginPath(); ctx.moveTo(bx, by); ctx.lineTo(ex, ey); ctx.stroke();
          ctx.strokeStyle = `rgba(${T.fieldRGB},1)`; ctx.fillStyle = `rgba(${T.fieldRGB},1)`; ctx.lineWidth = 3;
          ctx.beginPath(); ctx.moveTo(bx, by); ctx.lineTo(ex, ey); ctx.stroke();
          ctx.beginPath(); ctx.moveTo(ex, ey);
          ctx.lineTo(ex - 8 * Math.cos(ang - 0.45), ey - 8 * Math.sin(ang - 0.45));
          ctx.lineTo(ex - 8 * Math.cos(ang + 0.45), ey - 8 * Math.sin(ang + 0.45));
          ctx.closePath(); ctx.fill();
          ctx.textAlign = "left"; txt(ctx, "B", ex - 14, ey + 14, 0.95); ctx.textAlign = "center";
        }
        // Current arrow above the slab, counters below.
        const [tx0, ty0] = P(k, 0.15 * Lx, Ly, Lz), [tx1] = P(k, 0.85 * Lx, Ly, Lz), yar = ty0 - 14, dir = st.s;
        const aS = dir > 0 ? tx0 : tx1, aE = dir > 0 ? tx1 : tx0;
        ctx.strokeStyle = `rgba(${T.curRGB},0.95)`; ctx.fillStyle = `rgba(${T.curRGB},0.95)`; ctx.lineWidth = 2;
        ctx.beginPath(); ctx.moveTo(aS, yar); ctx.lineTo(aE, yar); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(aE, yar); ctx.lineTo(aE - dir * 8, yar - 4.5); ctx.lineTo(aE - dir * 8, yar + 4.5); ctx.closePath(); ctx.fill();
        txt(ctx, st.s > 0 ? "+J" : "−J", (aS + aE) / 2, yar - 7, 0.95);
        const cxm = ox[k] + (Lx * sc + Lz * ZX * sc) / 2, rt = rateOf(st);
        txt(ctx, `${st.s > 0 ? "vortex" : "antivortex"} crossings: ${st.n}`, cxm, oy + 22, 0.95);
        txt(ctx, (rt ? `rate ${rt.toFixed(2)} /s` : "rate …") + (REGIMES[regime].serial ? (st.vs.length ? " · crossing" : " · waiting at the tip") : ""), cxm, oy + 38, 0.8);
      });
      // Legend.
      ctx.textAlign = "left";
      ctx.font = `11px "IBM Plex Mono", monospace`;
      if (!(w < 560)) {
        const lx = 14, ly = 22;
        txt(ctx, "B  field, out of the page (arrow)", lx, ly, 0.9);
        ctx.strokeStyle = `rgba(${T.curRGB},0.9)`; ctx.lineWidth = 1.6; ctx.setLineDash([6, 5]);
        ctx.beginPath(); ctx.moveTo(lx, ly + 16); ctx.lineTo(lx + 20, ly + 16); ctx.stroke(); ctx.setLineDash([]);
        txt(ctx, "current lines (crowd at the tip)", lx + 28, ly + 20, 0.9);
        ctx.strokeStyle = `rgba(${T.inkRGB},0.9)`; ctx.lineWidth = 2.2;
        ctx.beginPath(); ctx.moveTo(lx + 8, ly + 30); ctx.lineTo(lx + 14, ly + 38); ctx.stroke();
        txt(ctx, "vortex line · Lorentz force F = J × B", lx + 28, ly + 40, 0.9);
      }
      ctx.restore();
      const rp = rateOf(strips[0]), rm = rateOf(strips[1]);
      const nr = rp + rm > 0 ? (rp - rm) / (rp + rm) : 0;
      readout(ctx, w, hero, rp && rm ? `voltage non-reciprocity ≈ ${(100 * nr).toFixed(0)} %` : "measuring…");
    }

    return {
      caption:
        "The geometric diode in one picture: the same notched slab in a field out of the page, driven by +J (left) and by −J (right). The current lines bend over the notch and crowd at its tip, where vortices nucleate and cross the sample as lines through its thickness — a vortex for one current, an antivortex for the other. Rectification is the difference in how long the next one waits at the tip, where the order parameter dims as the wait ends. Switch to compare a weak and a strong asymmetry, or a higher field with a train of vortices. A cartoon of the mechanism with illustrative parameters, not solver output.",
      options: REGIMES.map((rg, idx) => ({ label: rg.label, active: () => regime === idx, apply: () => { regime = idx; resetStrips(); } })),
      resize(nw2, nh2) {
        w = nw2; h = nh2; f.resize(w, h);
        sc = Math.max(5, Math.min((w / 2 - 30) / (Lx + Lz * ZX), (h - 166) / (Ly + Lz * ZY)));
        oy = h - 98;
        const span = Lx * sc + Lz * ZX * sc;
        ox = [w * 0.25 - span / 2, w * 0.75 - span / 2];
        resetStrips();
      },
      reset() { resetStrips(); },
      frame(ctx, dt) { step(dt); draw(ctx); },
      settle(ctx) { draw(ctx); },
      coarsen() { if (f.cell < 6) { f.cell++; f.resize(w, h); } },
    };
  }

  const factories: Record<string, (hero: boolean) => Scene> = {
    crystal: crystalScene, vortex: vortexScene, weyl: weylScene, light: lightScene, diode: diodeScene,
  };

  function setup(root: HTMLElement) {
    const hero = root.dataset.variant === "hero";
    const ids = root.dataset.scenes!.split(",");
    const canvas = root.querySelector("canvas")!;
    const ctx = canvas.getContext("2d", { alpha: false })!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-scene]")];
    const pauseBtn = root.querySelector<HTMLButtonElement>('[data-act="pause"]')!;
    const captionEl = hero
      ? document.querySelector<HTMLElement>("[data-scene-caption]")
      : (root.nextElementSibling as HTMLElement | null);
    const scenes = ids.map((id) => factories[id](hero));
    const dpr = Math.min(window.devicePixelRatio || 1, hero ? 1.5 : 2);

    let cur = 0, w = 0, h = 0;
    let running = !reduced, visible = true, auto = ids.length > 1 && root.dataset.auto === "true";
    let lastSwitch = performance.now(), last = 0, cost = 0, raf = 0, switching = false;

    // Per-scene options (e.g. a regime toggle) are rebuilt for the active scene.
    const optsBox = document.createElement("div");
    optsBox.className = "scenes-tabs";
    root.querySelector(".scenes-hud")!.prepend(optsBox);
    function drawOptions() {
      optsBox.innerHTML = "";
      if (hero) return; // the hero keeps only the scene tabs
      for (const o of scenes[cur].options ?? []) {
        const b = document.createElement("button");
        b.type = "button"; b.textContent = o.label;
        b.setAttribute("aria-pressed", String(o.active()));
        b.addEventListener("click", () => {
          o.apply();
          drawOptions();
          if (!running) { scenes[cur].settle(ctx); }
        });
        optsBox.appendChild(b);
      }
    }

    function label() {
      drawOptions();
      tabs.forEach((b, i) => b.setAttribute("aria-pressed", String(i === cur)));
      canvas.style.cursor = scenes[cur].drag ? "grab" : "";
      if (captionEl) captionEl.textContent = scenes[cur].caption;
    }

    function activate(i: number) {
      cur = i;
      scenes[cur].reset(ctx);
      if (!running) scenes[cur].settle(ctx);
      label();
    }

    // Cross-fade: freeze the outgoing frame on an overlay, start the next
    // scene underneath, and fade the overlay out.
    function go(i: number) {
      if (i === cur || switching) return;
      switching = true;
      const snap = document.createElement("canvas");
      snap.width = canvas.width; snap.height = canvas.height;
      snap.getContext("2d")!.drawImage(canvas, 0, 0);
      snap.className = "scenes-snap";
      root.insertBefore(snap, canvas.nextSibling);
      activate(i);
      lastSwitch = performance.now();
      requestAnimationFrame(() => { snap.style.opacity = "0"; });
      setTimeout(() => { snap.remove(); switching = false; }, 1300);
    }

    function resize() {
      const r = root.getBoundingClientRect();
      if (r.width < 10 || r.height < 10) return;
      w = r.width; h = r.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      scenes.forEach((s) => s.resize(w, h));
      scenes[cur].reset(ctx);
      scenes[cur].settle(ctx);
      root.classList.add("ready");
    }

    function loop(now: number) {
      cancelAnimationFrame(raf);
      if (!running || !visible || document.hidden) return;
      // Never negative: a rAF timestamp can precede the performance.now() passed by resume().
      const dt = Math.max(0, Math.min(0.05, last ? (now - last) / 1000 : 1 / 30));
      last = now;
      if (auto && now - lastSwitch > 20000) go((cur + 1) % scenes.length);
      const t0 = performance.now();
      scenes[cur].frame(ctx, dt);
      cost = 0.9 * cost + 0.1 * (performance.now() - t0);
      if (cost > 16) { scenes[cur].coarsen?.(); cost = 0; }
      raf = requestAnimationFrame(loop);
    }

    function resume() { last = 0; cancelAnimationFrame(raf); raf = requestAnimationFrame(loop); }

    tabs.forEach((b, i) => b.addEventListener("click", () => { auto = false; go(i); }));
    pauseBtn.addEventListener("click", () => {
      running = !running;
      pauseBtn.textContent = running ? "Pause" : "Play";
      pauseBtn.setAttribute("aria-pressed", String(!running));
      if (running) resume();
    });

    const toLocal = (e: PointerEvent) => {
      const r = root.getBoundingClientRect();
      return { x: e.clientX - r.left, y: e.clientY - r.top };
    };
    const host = hero ? (root.parentElement as HTMLElement) : root;
    host.addEventListener("pointermove", (e) => { if (e.pointerType === "mouse") scenes[cur].pointer?.(toLocal(e)); });
    host.addEventListener("pointerleave", () => scenes[cur].pointer?.(null));

    // Drag to rotate (crystal). Vertical swipes still scroll the page on phones.
    let dragFrom: Pt | null = null;
    canvas.style.touchAction = "pan-y";
    canvas.addEventListener("pointerdown", (e) => {
      if (!scenes[cur].drag) return;
      dragFrom = toLocal(e);
      canvas.setPointerCapture(e.pointerId);
      canvas.style.cursor = "grabbing";
    });
    canvas.addEventListener("pointermove", (e) => {
      if (!dragFrom) return;
      const p = toLocal(e);
      scenes[cur].drag?.({ dx: p.x - dragFrom.x, dy: p.y - dragFrom.y });
      dragFrom = p;
      if (!running) scenes[cur].frame(ctx, 0);
    });
    const endDrag = () => {
      if (!dragFrom) return;
      dragFrom = null;
      scenes[cur].drag?.(null);
      canvas.style.cursor = scenes[cur].drag ? "grab" : "";
    };
    canvas.addEventListener("pointerup", endDrag);
    canvas.addEventListener("pointercancel", endDrag);

    new MutationObserver(() => {
      applyTheme();
      scenes[cur].reset(ctx);
      scenes[cur].settle(ctx);
    }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

    new ResizeObserver(resize).observe(root);
    new IntersectionObserver((en) => {
      visible = en[0].isIntersecting;
      if (visible && running) resume();
    }).observe(root);
    document.addEventListener("visibilitychange", () => { if (!document.hidden && running) resume(); });

    resize();
    label();
    if (reduced) { pauseBtn.textContent = "Play"; pauseBtn.setAttribute("aria-pressed", "true"); }
    else resume();
  }

  document.querySelectorAll<HTMLElement>("[data-scenes]").forEach(setup);
</script>
