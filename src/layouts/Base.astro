---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  flush?: boolean;
}
const { title, description, flush = false } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/research", label: "Research" },
  { href: "/lab", label: "Lab" },
  { href: "/software", label: "Software" },
  { href: "/cv", label: "CV" },
];
const pageTitle = title ? `${title} — ${site.short}` : `${site.name} — Physicist`;
const desc =
  description ??
  "Physicist: experimental materials (spinel ferrites) and a validated 3D two-band superconductor solver. Open to scientific software, data and R&D roles.";
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/figs/stg_ref_psi.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={desc} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
    <script is:inline>
      // Default theme by the visitor's local time: dark from 16:00 to 08:00,
      // light during the day. A choice made with the toggle is remembered.
      (function () {
        var DARK_FROM = 16, DARK_TO = 8;
        var t = null;
        try { t = localStorage.getItem("theme"); } catch (e) {}
        if (t !== "light" && t !== "dark") {
          var h = new Date().getHours();
          t = h >= DARK_FROM || h < DARK_TO ? "dark" : "light";
        }
        // ?theme=light|dark forces a theme for this visit (handy to share a view).
        var q = /[?&]theme=(light|dark)/.exec(location.search);
        if (q) t = q[1];
        if (/[?&]nofade/.test(location.search)) document.documentElement.dataset.nofade = "";
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Source+Serif+4:opsz,wght@8..60,600&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Source+Serif+4:opsz,wght@8..60,600&display=swap" /></noscript>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="mark" href="/">{site.short}</a>
        <div class="header-right">
          <nav aria-label="Main">
            {
              links.map((l) => (
                <a href={l.href} aria-current={here === l.href ? "page" : undefined}>
                  {l.label}
                </a>
              ))
            }
          </nav>
          <button class="theme-toggle" type="button" aria-label="Switch between light and dark theme">
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          </button>
        </div>
      </div>
    </header>
    <main class={flush ? "flush" : undefined}>
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <p>
          {site.name}<br />
          {site.place}
        </p>
        <p>
          <a href={`mailto:${site.email}`}>{site.email}</a> ·
          <a href={site.github}>GitHub</a> ·
          <a href={site.linkedin}>LinkedIn</a> ·
          <a href={site.orcid}>ORCID</a><br />
          Updated {site.updated}
        </p>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
      toggle?.addEventListener("click", () => {
        const root = document.documentElement;
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch (e) {}
      });
    </script>
  </body>
</html>
